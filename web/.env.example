# Copy this file to .env and fill in your values. .env is git-ignored.

# Required. Generate one with: openssl rand -hex 32
# Must match API_KEY in secrets.h on the ESP32
API_KEY=change-me

# Optional; these are the defaults
DATABASE_URL=sqlite:data.db
BIND_ADDRESS=0.0.0.0:3000
# Seconds without a beat before the power counts as off (3x the ESP32's beat interval)
OUTAGE_THRESHOLD_SECS=90
RUST_LOG=info,web=debug
# Hours ahead of UTC used for "today" and "this week" (Lagos = 1)
UTC_OFFSET_HOURS=1